+++ b/deluge/src/deluge/processing/vector_rendering_function.h	2026-11-12 16:07:59
@@ -33,8 +33,12 @@
 		strength2[i] = rshifted;
 
 		uint32_t whichValue = phase >> (32 - tableSizeMagnitude);
-		uint32_t* readAddress = (uint32_t*)((uint32_t)table + (whichValue << 1));
-		readValue[i].Load(readAddress);
+		// mpc-deluge: the table holds 16-bit values, so this 32-bit read is only 2-byte aligned.
+		// clang would emit a NEON lane load that demands 4-byte alignment and faults on 32-bit ARM
+		// (it crashed a Force), so read through memcpy, which assumes nothing. Also 64-bit safe.
+		uint32_t readWord;
+		__builtin_memcpy(&readWord, (const char*)table + (whichValue << 1), sizeof(readWord));
+		readValue[i].Set(readWord);
 	});
 
 	strength2 = strength2 >> 1;
diff -ruN a/deluge/src/deluge/util/container/array/ordered_resizeable_array.h b/deluge/src/deluge/util/container/array/ordered_resizeable_array.h
--- a/deluge/src/deluge/util/container/array/ordered_resizeable_array.h	2026-01-09 15:14:15
+++ b/deluge/src/deluge/util/container/array/ordered_resizeable_array.h	2026-11-12 16:07:59
@@ -51,12 +51,12 @@
 
 protected:
 	inline int32_t getKeyAtMemoryLocation(void* address) {
-		int32_t keyBig = *(uint32_t*)((uint32_t)address + keyOffset) << keyShiftAmount;
+		int32_t keyBig = *(uint32_t*)((uintptr_t)address + keyOffset) << keyShiftAmount;
 		return keyBig >> keyShiftAmount; // We use shifting instead of a mask so negative numbers get treated directly.
 	}
 
 	inline void setKeyAtMemoryLocation(int32_t key, void* address) {
-		uint32_t offsetAddress = (uint32_t)address + keyOffset;
+		uintptr_t offsetAddress = (uintptr_t)address + keyOffset; // mpc-deluge: 64-bit pointers
 		uint32_t prevContents = *(uint32_t*)offsetAddress;
 		*(uint32_t*)offsetAddress = (key & keyMask) | (prevContents & ~keyMask);
 	}
diff -ruN a/deluge/src/deluge/util/d_stringbuf.h b/deluge/src/deluge/util/d_stringbuf.h
